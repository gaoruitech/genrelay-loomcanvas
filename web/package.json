{
  "name": "loomcanvas-web",
  "version": "0.1.0",
  "description": "LoomCanvas web app: Vue 3 + Vue Flow node editor of the AI canvas, also buildable as an embeddable app and canvas editor",
  "keywords": [
    "ai-canvas",
    "node-editor",
    "node-based",
    "visual-workflow",
    "workflow-editor",
    "infinite-canvas",
    "vue",
    "vue3",
    "vue-flow",
    "embeddable",
    "text-to-image",
    "image-to-video",
    "self-hosted",
    "byok"
  ],
  "homepage": "https://github.com/gaoruitech/loomcanvas/tree/master/web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaoruitech/loomcanvas.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/gaoruitech/loomcanvas/issues"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "dist-lib"
  ],
  "exports": {
    "./app": {
      "types": "./dist-lib/types/embed/app.d.ts",
      "import": "./dist-lib/app.js"
    },
    "./editor": {
      "types": "./dist-lib/types/embed/editor.d.ts",
      "import": "./dist-lib/editor.js"
    },
    "./standalone/app": {
      "types": "./dist-lib/types/embed/app.d.ts",
      "import": "./dist-lib/standalone/app.js"
    },
    "./standalone/editor": {
      "types": "./dist-lib/types/embed/editor.d.ts",
      "import": "./dist-lib/standalone/editor.js"
    },
    "./app.css": "./dist-lib/app.css",
    "./editor.css": "./dist-lib/editor.css",
    "./fonts.css": "./dist-lib/fonts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "node scripts/build-lib.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "i18n:check": "node scripts/check-i18n.mjs",
    "theme:check": "node scripts/check-theme.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.6.0",
    "pinia": "^2.1.0",
    "tdesign-vue-next": "^1.9.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.2.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "happy-dom": "^15.11.7",
    "typescript": "~5.6.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
