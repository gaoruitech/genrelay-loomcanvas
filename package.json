{
  "name": "loomcanvas",
  "version": "0.1.0",
  "description": "Open-source, self-hosted node-based AI canvas for image and video generation: visual workflows for text-to-image, image editing and image-to-video, with your own API keys",
  "keywords": [
    "ai-canvas",
    "node-editor",
    "node-based",
    "ai-workflow",
    "visual-workflow",
    "infinite-canvas",
    "text-to-image",
    "image-to-video",
    "video-generation",
    "ai-image-generator",
    "self-hosted",
    "byok",
    "nano-banana",
    "gemini",
    "veo",
    "gpt-image",
    "deepseek",
    "vue-flow"
  ],
  "homepage": "https://github.com/gaoruitech/genrelay-loomcanvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaoruitech/genrelay-loomcanvas.git"
  },
  "bugs": {
    "url": "https://github.com/gaoruitech/genrelay-loomcanvas/issues"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "install:all": "npm ci --prefix server && npm ci --prefix web",
    "start": "npm --prefix server start",
    "typecheck": "npm --prefix web run typecheck",
    "test": "npm --prefix server test",
    "test:web": "npm --prefix web test",
    "build": "npm --prefix web run build",
    "build:lib": "npm --prefix web run build:lib",
    "i18n:check": "npm --prefix web run i18n:check",
    "versions:check": "node scripts/check-versions.mjs",
    "licenses:check": "node scripts/licenses.mjs",
    "licenses:write": "node scripts/licenses.mjs --write",
    "check": "npm run versions:check && npm run licenses:check && npm run i18n:check && npm run test && npm run test:web && npm run build"
  }
}
