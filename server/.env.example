# ---- Required ----------------------------------------------------------------

# Master secret, at least 16 characters. Provider API keys are encrypted with
# it and login tokens are signed with a key derived from it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it stable: changing it makes stored provider keys unreadable.
SECRET_KEY=

# ---- Basics ------------------------------------------------------------------

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/loomcanvas

# Public address of this instance, e.g. https://canvas.example.com (no trailing
# slash). Optional. When set, file URLs are absolute, and upstream models can
# load reference media by URL instead of receiving it inline.
PUBLIC_URL=

# Access password. Empty = no login (only do that on a trusted network).
ACCESS_PASSWORD=

# Largest accepted upload, in MB.
MAX_UPLOAD_MB=50

# ---- Storage -----------------------------------------------------------------

# local | s3 | oss
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/files

# S3-compatible (AWS S3, Cloudflare R2, MinIO...).
# Needs: npm install @aws-sdk/client-s3 @aws-sdk/lib-storage
# Objects must be publicly readable at S3_PUBLIC_BASE_URL.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Alibaba Cloud OSS. Needs: npm install ali-oss
# Objects must be publicly readable at OSS_PUBLIC_BASE_URL.
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

# ---- Optional ----------------------------------------------------------------

# Directory of the built frontend (web/dist) to serve from this process.
WEB_DIST=

# Path to a custom billing hook module (see src/billing/index.js).
BILLING_HOOK=

# Extra origins allowed to call the API from a browser, comma separated,
# e.g. the Vite dev server: http://localhost:5173
CORS_ORIGIN=

# Set when running behind a reverse proxy so the login rate limit sees the
# real client address. A hop count (1) or an Express "trust proxy" value.
TRUST_PROXY=

# The server refuses to download from private/loopback addresses. If a model
# server on your own network returns result links that point at itself, list
# its host names or IPs here, comma separated.
SSRF_ALLOW_HOSTS=
