# ---- Required ----------------------------------------------------------------

# Master secret, at least 16 characters. Provider API keys and the saved S3
# secret are encrypted with it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it stable: changing it makes the stored provider keys and the saved S3
# secret unreadable, and each has to be entered again in the app.
SECRET_KEY=

# ---- Basics ------------------------------------------------------------------

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/loomcanvas

# Public address of this instance, e.g. https://canvas.example.com (no trailing
# slash). Optional. File URLs are always site-relative (/files/...), so the app
# works at any host and port; when this is set, upstream models can load
# reference media kept on the local disk by URL instead of receiving it inline.
PUBLIC_URL=

# ---- Super admin -----------------------------------------------------------

# The super admin account is created by the server itself, at the first
# start. These three are read at that moment only: once the account exists they
# are ignored, and changing them later changes nothing. Lost the password?
#   node server/src/cli/reset-password.js admin
# See docs/getting-started.md#accounts.

# Sign-in name, 3-32 characters: letters, digits, _ and -.
ADMIN_USERNAME=admin
# 8 to 128 characters. Left empty, a random password is generated and printed
# ONCE in the start-up log; whoever signs in with it has to choose a new one first.
ADMIN_PASSWORD=
# Optional. The super admin can also sign in with it, and add it later in the app.
ADMIN_EMAIL=

# May visitors create accounts themselves (ordinary users, never
# super admins)? true or false. Only the first value of the setting: once it
# has been saved (here or under Settings > Site) the saved value stands and
# this variable is ignored. Empty = open.
REGISTRATION_OPEN=

# Largest accepted upload, in MB.
MAX_UPLOAD_MB=50

# ---- Storage -----------------------------------------------------------------

# Storage is normally configured in the app, under Settings > Storage. A
# configuration saved there overrides everything in this block; these variables
# are only the default of an instance on which nothing was saved yet. The
# bucket the S3_* variables describe is also read whatever STORAGE_DRIVER
# says (files an install left there keep loading); remove the variables to
# stop that. See docs/storage.md.

# local | s3
STORAGE_DRIVER=local
# Directory of the local disk backend. Also read after a switch to S3: files
# stored before the switch stay here.
STORAGE_LOCAL_DIR=./data/files

# S3-compatible (STORAGE_DRIVER=s3): AWS S3, Cloudflare R2, Aliyun OSS, MinIO...
# The SDK is a regular dependency; nothing extra to install. The bucket can be
# private.
# Endpoint of the S3 API, without a path. Empty = AWS S3 (derived from the region).
#   R2:    https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   OSS:   https://oss-cn-hangzhou.aliyuncs.com
#   MinIO: http://127.0.0.1:9000
S3_ENDPOINT=
# Default us-east-1. R2: auto. OSS: oss-cn-hangzhou.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing: true for MinIO and most self-hosted services, false
# for AWS S3, R2 and OSS.
S3_FORCE_PATH_STYLE=false
# Optional folder inside the bucket, e.g. loomcanvas
S3_KEY_PREFIX=
# Optional. Public address that maps to the root of the bucket (custom domain,
# CDN, r2.dev), no trailing slash.
S3_PUBLIC_BASE_URL=
# Optional. The address the S3 service has from the internet (no path), when
# S3_ENDPOINT only works inside your network. Signed addresses handed to
# upstream models are made for it; a reverse proxy there must keep the Host header.
S3_PRESIGN_ENDPOINT=
# proxy    = this server streams files from the bucket (private bucket, no CORS)
# redirect = /files/<key> redirects browsers to S3_PUBLIC_BASE_URL
# Empty    = redirect when S3_PUBLIC_BASE_URL is set, otherwise proxy.
S3_DELIVERY=
# Object ACL: empty (send none), private or public-read. Normally empty.
S3_ACL=

# ---- Optional ----------------------------------------------------------------

# Directory of the built frontend (web/dist) to serve from this process.
WEB_DIST=

# Path to a custom billing hook module (see docs/billing-hook.md). A relative
# path is resolved against the directory the server is started from.
BILLING_HOOK=

# Teams with a monthly amount limit only: how many output tokens a chat run
# priced per token is assumed to produce at most. It holds that much of the
# limit while it runs and is settled to its real cost when it ends (see
# docs/api.md, "Monthly limits"). Empty = 8192.
BUDGET_CHAT_RESERVE_OUTPUT_TOKENS=

# Extra origins allowed to call the API from a browser, comma separated,
# e.g. the Vite dev server: http://localhost:5173
CORS_ORIGIN=

# Set when running behind a reverse proxy so the login rate limit sees the
# real client address: the number of proxies in front (usually 1), or their
# addresses, comma separated (IP, CIDR, loopback, linklocal, uniquelocal).
TRUST_PROXY=

# The server refuses to download from private/loopback addresses. If a model
# server on your own network returns result links that point at itself, list
# its host names or IPs here, comma separated. This only concerns what the
# server downloads: it does not make a host reachable for upstream models.
SSRF_ALLOW_HOSTS=
