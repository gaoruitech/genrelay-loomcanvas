# ---------- Required / 必填 ----------
# Encrypts provider API keys stored in the database. Use a long random string (at least 16 characters).
# Do not change it later, or saved keys can no longer be decrypted.
# 加密数据库里保存的上游 API Key。请用足够长的随机字符串（至少 16 位），设置后不要再改。
SECRET_KEY=

# ---------- Optional / 可选 ----------
# Public address of this instance (e.g. https://canvas.example.com), no trailing slash. Optional:
# leave it empty for local or LAN use - files are addressed relative to whatever address the app
# is opened at, so any host and port works. Set it when the instance has a public address, so that
# upstream models can download reference media by URL (needed for video inputs when files are on the local disk).
# 本实例的公网地址（例如 https://canvas.example.com），末尾不带斜杠。可以不填：本机或内网使用时留空即可，
# 文件按「当前打开的地址」寻址，换主机、换端口都能用。实例有公网地址时再填，
# 这样上游模型可以按地址下载参考素材（文件存在本地磁盘上、又要用视频做输入时需要）。
PUBLIC_URL=

# Leave empty for no login (personal/local use). Set it when the instance is reachable by others.
# 留空表示不需要登录（个人本机使用）。实例能被他人访问时请设置。
ACCESS_PASSWORD=

# Port exposed on the host. 映射到宿主机的端口。
PORT=3000

# ---------- Storage / 存储 ----------
# Storage is normally configured in the app, under Settings > Storage. A configuration saved there
# overrides everything in this block; these variables are only the default of an instance on which
# nothing was saved yet. Files are kept on the local disk (the app_data volume) unless you say otherwise.
# See docs/storage.md.
# 存储一般在应用里的「设置 > 存储」配置。那里保存的配置优先于这一段里的所有变量；这些变量只是
# 还没保存过配置的实例的初始默认值。不做任何设置时，文件存在本地磁盘（app_data 数据卷）。
# 详见 docs/storage.zh-CN.md。

# local | s3
STORAGE_DRIVER=local

# S3-compatible storage (STORAGE_DRIVER=s3): AWS S3, Cloudflare R2, Aliyun OSS, MinIO...
# S3 兼容存储（STORAGE_DRIVER=s3）：AWS S3、Cloudflare R2、阿里云 OSS、MinIO 等。
# Endpoint of the S3 API, without a path. Empty = AWS S3 (derived from the region).
#   R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   OSS: https://oss-cn-hangzhou.aliyuncs.com
#   MinIO: http://minio:9000
# S3 接口地址，不带路径。留空 = AWS S3（由地域推出）。
S3_ENDPOINT=
# Default us-east-1. R2: auto. OSS: oss-cn-hangzhou.   默认 us-east-1；R2 填 auto；OSS 填 oss-cn-hangzhou 这样的写法。
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing: true for MinIO and most self-hosted services; leave empty for AWS S3, R2 and OSS.
# 路径风格寻址：MinIO 等自建服务填 true；AWS S3、R2、OSS 留空。
S3_FORCE_PATH_STYLE=
# Optional folder inside the bucket, e.g. loomcanvas.   可选，桶里的一个目录，例如 loomcanvas。
S3_KEY_PREFIX=
# Optional. Public address that maps to the root of the bucket (custom domain, CDN, r2.dev), no trailing slash.
# 可选。对应桶的根的公开地址（自定义域名、CDN、r2.dev），末尾不带斜杠。
S3_PUBLIC_BASE_URL=
# proxy = the app serves files from the bucket, which can stay private.
# redirect = browsers are redirected to S3_PUBLIC_BASE_URL.
# Empty = redirect when S3_PUBLIC_BASE_URL is set, otherwise proxy.
# proxy = 由本站从桶里读出文件转发，桶可以保持私有；redirect = 把浏览器重定向到 S3_PUBLIC_BASE_URL。
# 留空 = 设了 S3_PUBLIC_BASE_URL 时是 redirect，否则是 proxy。
S3_DELIVERY=
# Object ACL: empty (send none), private or public-read. Normally empty.
# 对象 ACL：留空（不发送）、private 或 public-read。一般留空。
S3_ACL=

# Upload size limit per file, in MB. 单文件上传上限（MB）。
MAX_UPLOAD_MB=50

# Behind a reverse proxy: how many proxies are in front (usually 1), or their addresses
# (IP / CIDR / loopback / linklocal / uniquelocal, comma-separated). Needed for the login
# rate limit to see the real client address. Leave empty when clients connect directly.
# 前面有反向代理时填代理的层数（一般是 1）或代理的地址，登录限速才能拿到真实的客户端地址；直连时留空。
TRUST_PROXY=

# Extra origins allowed to call the API from a browser, comma-separated. Empty = same origin only.
# 允许跨域调用接口的来源，逗号分隔；留空表示只允许同源。
CORS_ORIGIN=

# Path (inside the container) of a billing hook module, see docs/billing-hook.md. Empty = no hook.
# 计费钩子模块在容器内的路径，见 docs/billing-hook.zh-CN.md；留空表示不使用。
BILLING_HOOK=

# Hosts exempt from the private-address block when downloading results (an upstream on your own network).
# 下载生成结果时允许访问的内网主机（上游就在内网时才需要）。
SSRF_ALLOW_HOSTS=
