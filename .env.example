# ---------- Required / 必填 ----------
# Encrypts provider API keys stored in the database. Use a long random string (at least 16 characters).
# Do not change it later, or saved keys can no longer be decrypted.
# 加密数据库里保存的上游 API Key。请用足够长的随机字符串（至少 16 位），设置后不要再改。
SECRET_KEY=

# ---------- Optional / 可选 ----------
# Public address of this instance, used in share links. 本实例对外地址，用于分享链接。
PUBLIC_URL=http://localhost:3000

# Leave empty for no login (personal/local use). Set it when the instance is reachable by others.
# 留空表示不需要登录（个人本机使用）。实例能被他人访问时请设置。
ACCESS_PASSWORD=

# Port exposed on the host. 映射到宿主机的端口。
PORT=3000

# Storage: local | s3 | oss   存储方式
STORAGE_DRIVER=local

# S3-compatible storage (STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Aliyun OSS (STORAGE_DRIVER=oss)
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

# Upload size limit per file, in MB. 单文件上传上限（MB）。
MAX_UPLOAD_MB=50
